(global_label "IIC_SDA" (shape input) (at 81.28 198.12 0) (effects (font (size 1.0 1.0)) (justify right)) (uuid 95b27778-6809-5b26-868d-51c0f2cce735))
(text "MINICONSOLE / TFT V1.3 HEADER CARRIER" (at 25.4 15.24 0) (effects (font (size 2.54 2.54)) (justify left)) (uuid 6a255a72-a984-56db-8b55-bfdf298d0eb7))
(text "3.3V logic | MSP1141 ST7789 135x240 | 6 active-low buttons | optional passive piezo" (at 25.4 24.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a34e5189-d921-53f7-8f9d-0e2944575ec7))
(text "J5: GND / 3V3 / SCL GPIO44 / SDA GPIO5. R2/R3: 4.7k pull-ups. TFT CS tied GND; CS=-1." (at 25.4 31.75 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid d8ca0956-fba3-59f8-b777-f00120332a1b))
(text "Button pull-ups are enabled in firmware. No external pull-ups required." (at 25.4 112 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid f4b8d6f4-9ff2-5813-a4a9-8fd725fdb762))
(text "TFT: 3.3V SPI, header at TOP.\nGND VCC SCL SDA RES DC CS BLK.\nBLK controls the module transistor.\nFirmware requires a TFT display port." (at 155 110 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 45b2f8da-a238-5e29-954b-34d70ea1a0bf))
(text "Battery + -> SW7 throw 3 -> COM 2 -> J3 -> module B+.\nJ3 B- -> module B-. Module 5V header is unused.\nUSB can power the console with the battery switch OFF.\nCharging the battery requires the battery switch ON." (at 255 31 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 8f55c956-fbbf-5020-b528-65f0353c8e63))
(text "J3 is a short insulated pigtail to the\nS3 underside B+/B- charging pads.\nSolder before fitting the module." (at 255 128 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 6443b6d9-6c8e-5407-80b5-3e7470e7df5a))
(text "R1 + B1 are optional / DNP.\nR1: 220 ohm, 1/4 W axial film.\nChoose B1 OR an external low-current\npassive piezo on J4. GPIO4 PWM.\nFirmware currently has sound disabled." (at 255 229 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid b3fc718b-fcb2-515c-a341-44c30a10a559))
(text "Rear TP1-TP5: GND / 3V3 / switched BAT+ / SCL / SDA. Probe pads only; no extra components." (at 25.4 255.27 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5520318a-19cc-58c7-81f7-9a6d143e0bfa))
(text "70.1 x 30.1mm, 1.6mm FR4, 2 copper layers. H1-H4: carrier mounts; H5-H7: three TFT mounts." (at 25.4 264.16 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid d47734a5-5eda-5470-9202-c3ab61ca4aba))
(text "Rear S3 uses two 9-pin headers, pitch 2.54mm, rows 15.24mm apart. USB toward bottom edge." (at 25.4 271.78 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a015e6f1-6326-511d-8653-ecfebb172c60))
(text "Fit-check the actual generic S3 against the 1:1 template before ordering. Published board size: 23.5 x 18mm." (at 25.4 279.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 52377664-7022-5eeb-9169-27367a719a55))
